# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules

# next.js
/.next/
**/.next/
.next-*
**/.next-*/
**/.next-*
/out/
**/out/

# production
/build
**/build

# generated externalized assets
storage/assets/
backend/storage/assets/

# generated capacity test artifacts
artifacts/perf/

# compiled output
dist/
**/dist/

# debug / logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# uploads
uploads/

# env files (except examples)
.env*
!.env.example
!**/.env.example
!.env.local.example
!**/.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# editor/OS
.DS_Store
.idea/
.vscode/

# archives
*.zip
*.7z
*.tar
*.tar.gz

# accidental placeholder files
\[20
/from
/backend/src/test.txt

# ML model weights / large binaries
*.ckpt
*.pth
*.pt
*.onnx
*.safetensors
*.bin
*.tflite

# Large subprojects / ML dependencies (installed separately, not tracked in git)
ComfyUI/
CatVTON/
detectron2/

# ComfyUI runtime folders
**/models/
!backend/src/models/
!backend/src/models/**
**/input/
**/output/
**/temp/
**/user/
artifacts/backup/
artifacts/reconciliation/

# migration backups
backend/storage/migration-backups/

# large binary archives
*.rar
*.sql.gz

# Development logs & docs (local only)
LOG-*.md
docs/development-log-*.md
docs/archive/
docs/architecture/
shared/

# Local scripts
backend/scripts/
scripts/
docs-archive/
docs/*.md

# Hermes agent plans & local backups
.hermes/
backups/
docs/reports/

# Frontend backup files
*.backup-*
