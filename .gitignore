# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules

# next.js
/.next/
**/.next/
.next-*
**/.next-*/
**/.next-*
/out/
**/out/

# production
/build
**/build

# compiled output
dist/
**/dist/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# editor/OS
.DS_Store
.idea/
.vscode/

# archives
*.zip
*.7z
*.tar
*.tar.gz

# accidental placeholder files
\[20
/from
/backend/src/test.txt

# ML model weights / large binaries
*.ckpt
*.pth
*.pt
*.onnx
*.safetensors
*.bin
*.tflite

# Large subprojects / generated assets (keep repo lightweight)
ComfyUI/

# detectron2: commit source, not nested repo/build artifacts
detectron2/.git/
detectron2/**/.git/
detectron2/build/
detectron2/**/build/
detectron2/**/__pycache__/
detectron2/**/*.pyc
detectron2/**/*.pyo
detectron2/**/*.so
detectron2/**/*.o
detectron2/**/.pytest_cache/
detectron2/**/.mypy_cache/
detectron2/**/.ruff_cache/
detectron2/**/.eggs/
detectron2/**/dist/
detectron2/**/*.egg-info/

# CatVTON: commit code, not nested repos/artifacts
CatVTON/.git/
CatVTON/**/.git/
CatVTON/detectron2/_C*.so

# ComfyUI runtime folders (in case ComfyUI is included later)
**/models/
**/input/
**/output/
**/temp/
**/user/
