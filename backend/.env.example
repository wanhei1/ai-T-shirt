# 后端环境变量配置
# 复制此文件为 .env 并填入实际值

# 数据库配置 - 使用 Neon 云数据库
# DATABASE_URL=postgresql://username:password@host:5432/database_name

# 示例：
# DATABASE_URL=postgresql://your_username:your_password@ep-example-123456.us-east-1.aws.neon.tech/your_database?sslmode=require
# 多节点故障切换（可选，逗号分隔）：
# DATABASE_URLS=postgresql://primary-host:5432/db,postgresql://standby-host:5432/db
# 读写分离（可选）：为 GET 读请求配置只读副本
# DATABASE_READ_URL=postgresql://read-replica-host:5432/db
# DATABASE_READ_URLS=postgresql://read-1:5432/db,postgresql://read-2:5432/db

# 服务器配置
PORT=3001
NODE_ENV=development
SUPPRESS_POLLING_304_LOGS=true
# 全局 AI 开关：false 时禁用 AI 生成与试穿入队
AI_ENABLED=true

# RabbitMQ
# Local default broker commonly uses guest/guest. If you omit this variable,
# worker startup will try localhost with and without guest credentials.
RABBITMQ_URL=amqp://<rabbit_user>:<rabbit_password>@127.0.0.1:5672/<vhost>
# 多节点故障切换（可选，逗号分隔）：
# RABBITMQ_URLS=amqp://user:pass@mq-1:5672/vhost,amqp://user:pass@mq-2:5672/vhost

# Redis（任务状态持久化，可选）
# 默认要求配置 Redis，避免任务状态在重启后丢失
REDIS_URL=redis://127.0.0.1:6379
# 多节点故障切换（可选，逗号分隔）：
# REDIS_URLS=redis://redis-1:6379,redis://redis-2:6379,redis://redis-3:6379
REQUIRE_SHARED_JOB_STATE=true
# 仅用于本地临时调试：允许回退到内存任务状态（重启会丢失）
ALLOW_INMEMORY_JOB_STATE=false
RATE_LIMIT_REDIS_PREFIX=rl
CACHE_REDIS_PREFIX=cache
GALLERY_CACHE_TTL_SECONDS=30
GALLERY_ITEM_CACHE_TTL_SECONDS=30
MEMBERSHIP_CACHE_TTL_SECONDS=20
MEMBERSHIP_TRANSACTIONS_CACHE_TTL_SECONDS=20
CART_CACHE_TTL_SECONDS=15
ORDERS_SUMMARY_CACHE_TTL_SECONDS=20
ORDERS_LIST_CACHE_TTL_SECONDS=20
ADMIN_ORDERS_CACHE_TTL_SECONDS=10

# Job worker tuning
# Concurrency: how many jobs process in parallel per queue.
# Single GPU: keep at 1 (ComfyUI serializes). Multi-GPU: increase to 2-4.
JOB_CONCURRENCY_AI=1
JOB_CONCURRENCY_TRYON=1
# Max retry attempts per failed job (exponential backoff)
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_MS=5000
JOB_BACKOFF_MAX_MS=60000
JOB_BACKOFF_JITTER_RATIO=0.25
JOB_REMOVE_ON_COMPLETE=100
JOB_REMOVE_ON_FAIL=200
# 7 days
JOB_STATE_TTL_SECONDS=604800
AI_QUEUE_MAX_WAITING=100
TRYON_QUEUE_MAX_WAITING=50
JOB_OVERLOAD_RETRY_AFTER=15

# 入队限流（每分钟）
AI_RATE_LIMIT_IP_PER_MIN=60
AI_RATE_LIMIT_USER_PER_MIN=20
TRYON_RATE_LIMIT_IP_PER_MIN=30
TRYON_RATE_LIMIT_USER_PER_MIN=10

# 预算级成本护栏（每日）
# 模式：degrade=降级模板模式, delay=延迟重试, pause=暂停 AI
AI_BUDGET_GUARD_ENABLED=true
AI_BUDGET_GUARD_MODE=degrade
AI_BUDGET_DELAY_RETRY_AFTER_SECONDS=600
# AI 生成额度（/generate + /jobs ai-image）
AI_DAILY_USER_QUOTA=50
AI_DAILY_GLOBAL_QUOTA=2000
# 试穿额度（/jobs virtual-tryon）
TRYON_DAILY_USER_QUOTA=20
TRYON_DAILY_GLOBAL_QUOTA=1000

# Metrics endpoint auth (optional)
# If set, /metrics requires Authorization: Bearer <METRICS_TOKEN>
METRICS_TOKEN=
# Dependency probe interval in ms for dependency_up/dependency_check_duration_seconds
DEPENDENCY_CHECK_INTERVAL_MS=15000
# 账务对账巡检（billing reconciliation）
# 应用内定时巡检 + 指标上报
BILLING_RECONCILIATION_ENABLED=true
BILLING_RECONCILIATION_INTERVAL_MS=900000
BILLING_RECONCILIATION_LOOKBACK_HOURS=24
BILLING_RECONCILIATION_TOLERANCE=0.01
BILLING_RECONCILIATION_SAMPLE_LIMIT=20
# 独立脚本执行时：输出路径与失败策略
BILLING_RECONCILIATION_OUTPUT_PATH=
BILLING_RECONCILIATION_FAIL_ON_MISMATCH=false
# Alertmanager -> 自动工单 webhook（告警触发后自动生成排查单）
ALERT_TICKET_WEBHOOK_TOKEN=
ALERT_TICKET_OUTPUT_DIR=../artifacts/incidents

# 资产外置存储（用于将大 data URL 从 JSON/文本字段中抽离）
# 默认本地目录 + 静态路径，可替换为你的对象存储网关 URL
ASSET_STORAGE_DIR=./storage/assets
ASSET_PUBLIC_BASE_URL=/assets
# 大于等于该字节数的 data URL 图片会自动外置
ASSET_INLINE_MAX_BYTES=131072

# 前端URL (用于CORS)
FRONTEND_URL=http://localhost:3000

# 迁移流程
# API 启动阶段不会执行迁移，请在发布流程中单独执行：npm run migrate

# ComfyUI 地址（支持逗号分隔）
COMFYUI_URL=http://127.0.0.1:8188
# ComfyUI 安装根目录（模型、工作流模板等均基于此路径）
COMFYUI_ROOT=/usrhome/tyx/.data/FUZHUANG/custom-tshirt-designer/ComfyUI
COMFYUI_USE_ARGOS_WORKFLOW=true
COMFYUI_IMAGE_WORKFLOW_PATH=/usrhome/tyx/.data/FUZHUANG/custom-tshirt-designer/ComfyUI/user/default/workflows/imagegenerate_workflow.json
COMFYUI_TRANSLATE_FROM=chinese
COMFYUI_TRANSLATE_TO=english

# JWT密钥 (生产环境请使用复杂的随机字符串)
JWT_SECRET=<generate-a-random-32-plus-char-secret>

# 数据库选项
DB_SSL=true
DB_MAX_CONNECTIONS=20

# 数据归档任务（db:archive-orders）
# 默认 180 天前订单进入归档表；默认 dry-run=true
ORDERS_ARCHIVE_DAYS=180
ARCHIVE_DRY_RUN=true
ARCHIVE_BATCH_LIMIT=2000

# 每日自动备份执行器（backup:daily）
BACKUP_OUTPUT_DIR=../artifacts/backup
BACKUP_RETENTION_DAYS=7
# 需要备份的表（逗号分隔）
BACKUP_TABLES=orders,memberships,membership_transactions,order_idempotency_keys,all_designs,cart_items,design_usage_rewards,referral_redemptions

# 发布策略守门（release:guard）
# 候选版本 metrics 地址（必填，执行 release:guard 时）
RELEASE_CANDIDATE_METRICS_URL=
# 基线版本 metrics 地址（可选，用于 canary/blue-green 对比）
RELEASE_BASELINE_METRICS_URL=
# 如果 /metrics 受保护，填入 Bearer token
RELEASE_METRICS_TOKEN=
# 采样窗口（秒）
RELEASE_SAMPLE_SECONDS=60
# 绝对 SLO 阈值
RELEASE_MAX_ERROR_RATE=0.02
RELEASE_MAX_API_P95_SECONDS=1.0
RELEASE_MAX_QUEUE_WAIT_P95_SECONDS=120
RELEASE_MIN_DEPENDENCY_UP_RATIO=1.0
# 相对劣化阈值（candidate 相对 baseline）
RELEASE_MAX_ERROR_RATE_DEGRADATION_RATIO=0.5
RELEASE_MAX_LATENCY_DEGRADATION_RATIO=0.3
RELEASE_MAX_QUEUE_WAIT_DEGRADATION_RATIO=0.5
# 自动回滚触发
RELEASE_AUTO_ROLLBACK=false
RELEASE_ROLLBACK_WEBHOOK_URL=
RELEASE_ROLLBACK_WEBHOOK_TOKEN=

# 灾备能力（DR）基线配置
DR_ENFORCE_MULTI_AZ=true
# 仅限本地临时测试可设置 true；生产应保持 false
DR_ALLOW_SINGLE_NODE=false

# RTO/RPO 目标（分钟）
DR_RTO_CORE_SAME_AZ_MINUTES=15
DR_RPO_CORE_SAME_AZ_MINUTES=5
DR_RTO_CORE_CROSS_REGION_MINUTES=60
DR_RPO_CORE_CROSS_REGION_MINUTES=15

DR_RTO_AI_SAME_AZ_MINUTES=60
DR_RPO_AI_SAME_AZ_MINUTES=15
DR_RTO_AI_CROSS_REGION_MINUTES=240
DR_RPO_AI_CROSS_REGION_MINUTES=60

# 跨区域备份/恢复能力信号
DR_BACKUP_INCREMENTAL_MINUTES=15
DR_BACKUP_DAILY_FULL=true
DR_OBJECT_STORAGE_CROSS_REGION=true
DR_SECRETS_MULTI_REGION=true

# 成本可观测与单位成本模型（cost:report）
COST_METRICS_URL=
COST_METRICS_TOKEN=
COST_SAMPLE_SECONDS=300

# 基础设施单位成本（USD/小时）
COST_API_HOURLY_USD=0.12
COST_WORKER_HOURLY_USD=0.18
COST_GPU_HOURLY_USD=1.50

# 当期运行副本数（用于窗口成本估算）
COST_API_REPLICA_COUNT=2
COST_WORKER_REPLICA_COUNT=2
COST_GPU_REPLICA_COUNT=1

# 单次任务可变成本（USD/次）
COST_AI_VARIABLE_PER_OP_USD=0.002
COST_TRYON_VARIABLE_PER_OP_USD=0.003

# 成本阈值（USD/1000 次）
COST_AI_MAX_PER_1K_USD=120
COST_TRYON_MAX_PER_1K_USD=180