# Frontend Environment Variables
# Copy this file to .env.local and fill in actual values

# Backend API URL (server-side only)
# NEXT_PUBLIC_API_URL=http://localhost:8189

# ComfyUI server URL(s), comma-separated, tried in order
COMFYUI_URL=http://127.0.0.1:8188

# Client-visible ComfyUI URL (for display components)
# NEXT_PUBLIC_COMFYUI_URL=http://127.0.0.1:8188

# Allow frontend to connect to local ComfyUI (dev only)
# NEXT_PUBLIC_COMFYUI_ALLOW_LOCAL=false

# Text-to-image strict prompt alignment (default: true)
# NEXT_PUBLIC_TXT2IMG_STRICT_ALIGNMENT=true

# Virtual try-on settings
# TRYON_MIXED_PRECISION=true
# TRYON_STEPS=30
# TRYON_CFG=7.5
# TRYON_CLOTH_TYPE=dress
