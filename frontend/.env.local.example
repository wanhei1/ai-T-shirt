# API Configuration (可选 - 如果需要连接后端)
# NEXT_PUBLIC_API_URL=https://your-backend-api.com

# ComfyUI Configuration
# 支持多个服务器地址，用逗号分隔，按优先级排序
# 系统会自动按顺序尝试，直到找到可用的服务器
# 示例：优先走本地服务
# 生产建议：使用后端代理，不建议前端直连 8188
COMFYUI_URL=http://127.0.0.1:8188,http://localhost:8188

# 客户端可见的 ComfyUI URL（用于前端组件显示）
# 生产建议：不要填写公网 8188 地址，可留空或配置内部代理地址
NEXT_PUBLIC_COMFYUI_URL=http://127.0.0.1:8188

# 是否启用文生图严格提示词对齐（默认 true）。
# true: 前端不再自动拼接风格提示词，尽量与 8188 手动运行一致。
# false: 保留旧行为（前端拼接 style 模板正负词）。
NEXT_PUBLIC_TXT2IMG_STRICT_ALIGNMENT=true

# 文生图直连 ComfyUI（默认 false）
# false: 走后端队列 worker（推荐，稳定，可观测）
# true: 由前端 API /api/generate-image 直连 8188 执行生成
AI_DIRECT_COMFYUI=false

# 直连模式失败时是否自动回退到队列模式
AI_DIRECT_COMFYUI_FALLBACK_TO_QUEUE=true

# 生产环境是否允许测试接口 /api/test-comfyui（默认 false）
ALLOW_PROD_TEST_COMFYUI=false

# 直连模式等待超时（毫秒）
AI_DIRECT_COMFYUI_TIMEOUT_MS=600000

# Authentication (如果使用)
# NEXTAUTH_SECRET=your-secret-key
# NEXTAUTH_URL=https://your-domain.vercel.app
